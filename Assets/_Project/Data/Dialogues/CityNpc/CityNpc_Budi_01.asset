  - nodeId: rest
    fallbackLine: Iya sih, harusnya gitu ya. Tapi deadline numpuk, Bos nagih terus...
    variationPool: []
    choices: []
    npcFollowUpText: Makasih ya udah ngingetin. Kayaknya emang harus ambil napas
      dulu.
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: food
    fallbackLine: Belum nih, dari tadi cuma ngopi. Emang kalau ga makan, makin mumet
      ya?
    variationPool: []
    choices: []
    npcFollowUpText: Oke deh, habis ini aku cari makan. Makasih remindernya!
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: end_semangat
