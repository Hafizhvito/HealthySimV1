    isConversationEnd: 0
    isTerminal: 0
  - nodeId: detail
    fallbackLine: Katanya sih salad, smoothie, sama nasi brown rice gitu. Rame banget
      lho kemarin!
    variationPool: []
    choices: []
    npcFollowUpText: Cobain deh, siapa tau cocok sama selera kamu.
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: skeptis
    fallbackLine: Hahaha, itu mah stereotip. Sekarang makanan sehat udah enak-enak,
      Bos.
    variationPool: []
    choices: []
    npcFollowUpText: Coba dulu baru judge. Jangan kayak aku dulu, nyesel telat nyadar.
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: antusias
    fallbackLine: Nah, bagus! Lokasinya deket Rumah Sakit situ, ga jauh kok.
    variationPool: []
    choices: []
    npcFollowUpText: Semoga cocok ya sama seleramu!
    isConversationEnd: 0
    isTerminal: 1
