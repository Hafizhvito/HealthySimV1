        allowedPeriods: 
    npcFollowUpText: 
    isConversationEnd: 0
    isTerminal: 0
  - nodeId: istirahat
    fallbackLine: Iya nih, kaki udah pegel. Tapi ya namanya cari rejeki, harus semangat!
    variationPool: []
    choices: []
    npcFollowUpText: Makasih ya udah peduli. Jarang-jarang ada yang nyuruh istirahat,
      haha.
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: capek
    fallbackLine: Capek sih, tapi udah kebiasa. Justru kalau sehari ga jalan, badan
      malah kaku.
    variationPool: []
    choices: []
    npcFollowUpText: Yang penting makan teratur sama minum air yang banyak. Itu resep
      Mas Joko!
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: jualan
    fallbackLine: Macem-macem, ada buah potong, jus seger, sama kacang rebus.
    variationPool: []
    choices: []
    npcFollowUpText: Sehat-sehat semua, ga ada yang pake pengawet. Mau coba?
    isConversationEnd: 0
    isTerminal: 1
