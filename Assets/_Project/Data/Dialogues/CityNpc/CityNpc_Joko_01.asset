        allowedPeriods: 
    - choiceText: Pasti capek ya jualan keliling?
      nextNodeId: capek
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
        minEnergyPercent: 0
        minMoodPercent: 0
        minTrust: 0
        allowedPeriods: 
    - choiceText: Jualan apa, Mas?
      nextNodeId: jualan
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
