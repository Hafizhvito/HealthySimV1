  nodes:
  - nodeId: start
    fallbackLine: Dagangan hari ini lumayan laris! Tapi badan capek juga ya jalan
      terus dari pagi.
    variationPool: []
    choices:
    - choiceText: Istirahat dulu, Mas. Duduk bentar.
      nextNodeId: istirahat
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
