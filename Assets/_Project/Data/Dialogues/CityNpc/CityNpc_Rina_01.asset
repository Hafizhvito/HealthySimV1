    variationPool: []
    choices: []
    npcFollowUpText: Yang penting konsisten. Seminggu 3-4 kali aja udah berasa bedanya!
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: suka
    fallbackLine: "Wah, bagus banget! Jalan pagi itu double benefit \u2014 olahraga
