  backgroundResourcePath: 
  nodes:
  - nodeId: start
    fallbackLine: Mau coba jamu, Dek? Hari ini ada jahe merah, bagus buat daya tahan
      tubuh!
    variationPool: []
    choices:
    - choiceText: Boleh deh, jahe ya Bu!
      nextNodeId: beli
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
        minEnergyPercent: 0
        minMoodPercent: 0
        minTrust: 0
        allowedPeriods: 
    - choiceText: Jamu itu beneran manjur ya, Bu?
      nextNodeId: tanya
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
        minEnergyPercent: 0
        minMoodPercent: 0
        minTrust: 0
        allowedPeriods: 
    - choiceText: Ga deh Bu, makasih.
      nextNodeId: tolak
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
        minEnergyPercent: 0
        minMoodPercent: 0
        minTrust: 0
        allowedPeriods: 
    npcFollowUpText: 
    isConversationEnd: 0
    isTerminal: 0
  - nodeId: beli
    fallbackLine: Nih, jahe merah campur madu sama sereh. Anget-anget enak!
    variationPool: []
    choices: []
    npcFollowUpText: Diminum rutin ya, Dek. Biar badan tetep fit!
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: tanya
    fallbackLine: Ya kalo kata Ibu sih manjur, Dek. Jahe itu anti-inflamasi, kunyit
      bagus buat pencernaan.
    variationPool: []
    choices: []
    npcFollowUpText: Nenek moyang kita udah pake dari dulu. Sekarang malah banyak
      penelitian yang buktiin!
    isConversationEnd: 0
    isTerminal: 1
  - nodeId: tolak
    fallbackLine: Ya gapapa, Dek. Kapan-kapan aja kalau mau. Ibu di sini tiap hari
      kok!
    variationPool: []
    choices: []
    npcFollowUpText: 
    isConversationEnd: 0
    isTerminal: 1
