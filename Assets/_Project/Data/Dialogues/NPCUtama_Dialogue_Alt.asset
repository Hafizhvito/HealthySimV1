  npcId: npc_utama_alt
  npcDisplayName: Sari
  initialTrust: 18
  startNodeId: start
  nodes:
    - nodeId: start
      fallbackLine: Eh kamu lagi. Gimana, udah nggak sering muter-muter tanpa arah kan?
      variationPool:
        - Eh kamu lagi. Gimana, udah nggak sering muter-muter tanpa arah kan?
        - Ketemu lagi nih. Masih adaptasi atau udah mulai hafal spot sini?
      choices:
        - choiceText: Udah mendingan, tapi kadang nyasar dikit.
          nextNodeId: end_good
          consequence:
            energyDelta: 0
            moodDelta: 1
            calorieDelta: 0
            trustDelta: 2
            trackerAction: 2
          gate:
            useGate: 0
            minEnergyPercent: 0
            minMoodPercent: 0
            minTrust: 0
            allowedPeriods:
        - choiceText: Masih sama sih, kepala suka blank.
          nextNodeId: end_neutral
          consequence:
            energyDelta: 0
            moodDelta: 0
            calorieDelta: 0
            trustDelta: 1
            trackerAction: 4
          gate:
            useGate: 0
            minEnergyPercent: 0
            minMoodPercent: 0
            minTrust: 0
            allowedPeriods:
        - choiceText: Aku pura-pura nyasar biar ketemu kamu.
          nextNodeId: end_bad
          consequence:
            energyDelta: 0
            moodDelta: 0.5
            calorieDelta: 0
            trustDelta: 1
            trackerAction: 2
          gate:
            useGate: 0
            minEnergyPercent: 0
            minMoodPercent: 0
            minTrust: 0
            allowedPeriods:
      npcFollowUpText: Ya ampun, kamu suka bikin kaget ya.
      isConversationEnd: 0
      isTerminal: 0
    - nodeId: end_good
      fallbackLine: Bagus dong. Ntar lama-lama kamu juga hafal shortcut yang enak buat jalan sore.
      variationPool: []
      choices: []
      npcFollowUpText: Kalau ketemu lagi, kabarin progressmu ya.
      isConversationEnd: 1
      isTerminal: 1
    - nodeId: end_neutral
      fallbackLine: Gapapa sih. Aku juga dulu gitu, liat gang dikit langsung bingung.
      variationPool: []
      choices: []
      npcFollowUpText: Pelan-pelan aja, ntar kebiasa kok.
      isConversationEnd: 1
      isTerminal: 1
    - nodeId: end_bad
      fallbackLine: Halah, gombal mode on ya. Tapi oke, aku ketawa dikit.
      variationPool: []
      choices: []
      npcFollowUpText: Jangan sering-sering, ntar aku kebal.
      isConversationEnd: 1
      isTerminal: 1