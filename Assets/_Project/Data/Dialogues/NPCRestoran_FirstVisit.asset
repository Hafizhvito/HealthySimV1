  nodes:
  - nodeId: node_0
    fallbackLine: Eh, silakan silakan- duduk dulu. Lagi ngebersihin ini sebentar.
      Pertama kali ke sini? Biasanya kalau orang baru, bingung mau pesen apa. Tenang,
      nanti aku bantu.
    variationPool: []
    choices:
    - choiceText: Yang paling laku apa?
      nextNodeId: node_1_bestseller
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
        minEnergyPercent: 0
        minMoodPercent: 0
        minTrust: 0
        allowedPeriods: 
    - choiceText: Yang paling murah aja.
      nextNodeId: node_1_cheap
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
        minEnergyPercent: 0
        minMoodPercent: 0
        minTrust: 0
        allowedPeriods: 
    - choiceText: Rekomendasiin yang enak menurut kamu.
      nextNodeId: node_1_rec
      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
