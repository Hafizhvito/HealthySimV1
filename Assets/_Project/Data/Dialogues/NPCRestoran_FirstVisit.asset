      consequence:
        energyDelta: 0
        moodDelta: 0
        calorieDelta: 0
        trustDelta: 0
        trackerAction: 4
      gate:
        useGate: 0
        minEnergyPercent: 0
        minMoodPercent: 0
        minTrust: 0
        allowedPeriods: 
    npcFollowUpText: Pelanggan yang pertama kali nyoba biasanya langsung balik lagi.
      Itu ukuran paling jujur.
    isConversationEnd: 0
    isTerminal: 0
  - nodeId: node_2_browse
    fallbackLine: Silakan. Mau yang berat atau yang ringan? Kalau habis aktivitas
      banyak, mending yang ada nasinya. Kalau mau santai aja, yang sayur atau buah
      juga ada.
    variationPool: []
    choices:
    - choiceText: Yang berat sekalian.
