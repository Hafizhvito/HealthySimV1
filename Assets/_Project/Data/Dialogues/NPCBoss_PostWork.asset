  nodes:
  - nodeId: node_0
    fallbackLine: Kerja bagus hari ini. Kelihatan fit, hasilnya juga beres semua.
    variationPool: []
    choices: []
    npcFollowUpText: Ini gajinya, ada bonusnya sedikit.
    isConversationEnd: 1
    isTerminal: 1
  - nodeId: node_0_partial
    fallbackLine: Udah berusaha, tapi keliatannya kurang fit tadi. Kerjaan sebagian
      selesai.
    variationPool: []
    choices: []
    npcFollowUpText: Besok jaga kondisi ya. Makan yang bener sebelum kerja.
    isConversationEnd: 1
    isTerminal: 1
  - nodeId: node_0_failed
    fallbackLine: Kamu ga keliatan fit sama sekali tadi. Istirahat dulu aja, jangan
      dipaksain.
    variationPool: []
    choices: []
    npcFollowUpText: Badan itu modal utama. Kalau ambruk, malah rugi semua.
    isConversationEnd: 1
    isTerminal: 1
