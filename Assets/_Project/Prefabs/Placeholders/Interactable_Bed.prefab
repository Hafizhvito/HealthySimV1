  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45b57e43fe47ddb4d8fcddb9b1ca209a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SleepBedInteractable
  interactionText: Tekan E untuk tidur
  blockedBeforeNightText: Belum malam. Kamu belum bisa tidur sekarang.
  blockedRepeatedText: Kamu tidak bisa tidur terus-menerus. Lanjutkan aktivitasmu
    dulu sampai malam.
  sleepingLogText: Kamu tidur nyenyak. Hari berganti ke pagi.
  blockedWarningCooldown: 0.8
  blockedBurstWindow: 4
  blockedBurstThreshold: 3
  requireConfirmBeforeSleep: 1
  confirmWindowDuration: 2.2
  confirmPromptDuration: 1.8
  confirmPromptText: Tekan E sekali lagi untuk tidur.
  confirmPromptWithRiskTemplate: 'Tekan E sekali lagi untuk tidur. Risiko tidur terganggu:
    {0}%'
  fullRecoveryNormalized: 1
  lowEnergyWarningThreshold: 0.35
  bestTrainingDrainModifier: 0.85
  worstTrainingDrainModifier: 1.15
  enableSleepDisturbance: 1
  baseDisturbChance: 0.05
  chanceIfNoWork: 0.2
  chanceIfOverwork: 0.25
  chanceIfPoorDiet: 0.15
  disturbedRecoveryNormalized: 0.65
  poorDietThresholdDelta: 2
  requireNightToSleep: 0
  clockSkipDuration: 2.7
  fadeDuration: 0.33
  sleepLockSource: SleepTransition
  enablePreSleepCinematic: 1
  eyeCloseDuration: 0.95
  warmLineHoldDuration: 0.9
  warmSleepLines:
  - Hari ini mungkin belum sempurna, tapi tubuhmu tetap layak dipeluk oleh istirahat.
  - Kamu sudah berjuang seharian. Sekarang biarkan malam menyelesaikan sisanya.
  - Tarik napas pelan. Besok bukan untuk menebus, tapi untuk memulai lagi.
  - Tidak apa-apa melambat. Tubuhmu bukan mesin, ia teman seperjalanan.
  - Kadang yang paling sehat bukan berlari lebih jauh, tapi berhenti tepat waktu.
  enableWakeEyeOpenCinematic: 1
  eyeOpenDuration: 1
  wakeLineHoldDuration: 0.5
  warmWakeLines:
  - Pelan-pelan buka mata. Hari ini masih memberi ruang untuk memulai dengan lembut.
  - Pagi datang tanpa menuntutmu sempurna. Cukup hadir, lalu lanjut satu langkah.
  - Napasmu sudah kembali tenang. Sekarang giliran ritmemu kembali seimbang.
  - Tubuhmu sudah bekerja semalaman untuk pulih. Dengarkan dia hari ini.
  - Cahaya pagi selalu baru. Kamu juga boleh mulai dari versi baru dirimu.
  wakeMessageDuration: 3
  wakeIntroTemplate: Kamu bangun di Hari {0}.
  wakeWarningNoWork: 'Peringatan: Kemarin kamu belum kerja. Atur ritme harimu lebih
    baik.'
  wakeWarningLowEnergy: 'Peringatan: Kemarin kamu tidur saat energi sangat rendah.'
  wakeWarningDisturbedSleep: 'Peringatan: Tidurmu kurang nyenyak, jadi energimu belum
    pulih penuh.'
  agingNotificationTemplate: Tubuhmu memasuki fase {0} pada Hari {1}.
  agingNotificationDetailTemplate: Transisi dari fase {0} ke {1}.
  enableLateWakePenalty: 1
  sugarSignalWeight: 0.15
  overworkSignalWeight: 0.2
  fatigueSignalWeight: 0.15
  lowEnergySignalWeight: 0.25
  lateWakeChanceCap: 0.75
  lateWakePenaltyAmount: 15
  lowEnergySleepPenaltyThreshold: 0.2
  highFatigueDebtThreshold: 60
  highSugarEstimateThreshold: 45
  wakeWarningLateWakePenalty: Kamu bangun dengan badan terasa berat. Pola hidupmu
    mulai berdampak...
